{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "webextensions": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "chrome": "readonly"
  },
  "ignorePatterns": [
    "dist/",
    "dist-firefox/",
    "node_modules/",
    "lib/vendor/",
    "**/*.min.js"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/**/*.js",
        "tools/**/*.mjs"
      ],
      "env": {
        "node": true,
        "browser": false
      }
    }
  ]
}
